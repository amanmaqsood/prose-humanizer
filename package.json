{
  "name": "prose-humanizer",
  "version": "4.0.0",
  "description": "Humanize prose and lint recurring AI-style writing patterns without guessing authorship.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amanmaqsood/prose-humanizer.git"
  },
  "homepage": "https://github.com/amanmaqsood/prose-humanizer#readme",
  "bugs": "https://github.com/amanmaqsood/prose-humanizer/issues",
  "type": "commonjs",
  "bin": {
    "prose-lint": "bin/prose-lint.js",
    "prose-humanizer": "bin/prose-lint.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "benchmark": "node scripts/run_benchmark.js --candidates evals/reference",
    "validate": "python scripts/validate_skill.py && python -m unittest discover -s tests -p \"test_*.py\" && npm test && python scripts/build_plugin.py --check && npm pack --dry-run",
    "check": "npm run validate"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "writing",
    "editing",
    "humanize",
    "prose",
    "lint",
    "agent-skill"
  ],
  "files": [
    ".prose-humanizer.example.json",
    "CHANGELOG.md",
    "SKILL.md",
    "agents/",
    "assets/",
    "bin/",
    "evals/",
    "lib/",
    "references/",
    "rules/",
    "schemas/",
    "scripts/",
    "LICENSE"
  ]
}
